# Pliki tymczasowe i zrzuty bazy
*.zip
*.csv
*.sql
*.txt
*.docx

# ...ale migracje to kod źródłowy schematu, nie zrzut danych — muszą być w repo,
# inaczej struktura bazy istnieje wyłącznie na jednym dysku. Sekretów nie zawierają.
!migracje*.sql

# ...ale statyczne assety publiczne muszą trafiać na deploy
!public/robots.txt

# Kopie zapasowe — lokalne archiwa, nie do repozytorium
kopie/

# Podgląd HTML z `node scripts/media-pdf.mjs --html` — pomoc przy poprawianiu
# wyglądu wydruku, nie treść. Źródłem jest media.md, wynikiem media.pdf.
media-podglad.html

# Katalogi robocze narzędzi (zapisy sesji, historia asystentów).
# Bez tego `git add -A` wciąga je do repozytorium przy pierwszej okazji.
.specstory/
.exportal/
.waylog/

# Cudze repozytorium sklonowane obok (wtyczki do Claude Code). Ma własny .git,
# więc bez tej linii `git add -A` wciągnąłby je jako zagnieżdżony moduł.
agent-toolkit/
